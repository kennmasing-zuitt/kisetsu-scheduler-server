{
    "name": "express-typescript-graphql-boilerplate-server",
    "version": "1.0.0",
    "description": "Express 5 + TypeScript + Apollo GraphQL + MongoDB boilerplate",
    "main": "dist/server.js",
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "tsx watch --env-file=.env src/server.ts",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit",
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/server.js",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "seed": "tsx --env-file=.env src/scripts/seed.ts",
        "seed:reset": "tsx --env-file=.env src/scripts/seed.ts --reset",
        "schema:print": "NODE_ENV=development tsx src/scripts/printSchema.ts"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kennmasing-zuitt/express-typescript-boilerplate.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@apollo/server": "^5.5.1",
        "@as-integrations/express5": "^1.1.2",
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.6",
        "envalid": "^8.2.0",
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.1",
        "graphql": "^16.14.2",
        "graphql-scalars": "^1.26.0",
        "helmet": "^8.3.0",
        "install": "^0.13.0",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^9.11.1",
        "reflect-metadata": "^0.2.2",
        "type-graphql": "^2.0.0-rc.3",
        "winston": "^3.19.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.6.5",
        "@types/supertest": "^7.2.1",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-n": "^18.4.1",
        "prettier": "^3.9.10",
        "supertest": "^7.3.1",
        "tsx": "^4.23.15",
        "typescript": "~6.0.0",
        "typescript-eslint": "^8.71.2",
        "vitest": "^5.0.4"
    }
}
