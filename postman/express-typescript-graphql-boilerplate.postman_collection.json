                        "header": [],
                        "body": {
                            "mode": "graphql",
                            "graphql": {
                                "query": "mutation CreateExample($input: CreateExampleInput!) {\n    createExample(input: $input) {\nid\nfirstName\nlastName\ncreatedAt\nupdatedAt\n    }\n}\n",
