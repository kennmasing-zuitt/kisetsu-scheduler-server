                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('HTTP 200 with no GraphQL errors', () => {",
                                    "    pm.response.to.have.status(200);",
                                    "    pm.expect(pm.response.json().errors, JSON.stringify(pm.response.json().errors)).to.be.undefined;",
