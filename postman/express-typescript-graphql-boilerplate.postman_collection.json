                            }
                        },
                        "url": {
                            "raw": "{{baseUrl}}/graphql",
                            "host": ["{{baseUrl}}"],
                            "path": ["graphql"]
                        },
                        "description": "(Was `POST /api/v1/example/createExample`.) Saves the new id to `{{exampleId}}`."
