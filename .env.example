# .env.example
NODE_ENV=development
PORT=2200
LOG_LEVEL=debug
MONGO_URI=mongodb://localhost:27017/<app-name>
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-32-plus-chars
JWT_EXPIRES_IN=1h
# Lifetime of tokens issued by impersonateUser (keep it short)
IMPERSONATION_TOKEN_TTL=15m
BCRYPT_SALT_ROUNDS=10
CORS_ORIGINS=http://localhost:2400
AUTH_RATE_LIMIT_MAX=5
API_RATE_LIMIT_MAX=300
TRUST_PROXY=0
# Schedule: time zone for weekdays/leave dates/opening hours, and the opening hours
SCHEDULE_TIMEZONE=Asia/Manila
SCHEDULE_OPENING_TIME=10:00
SCHEDULE_CLOSING_TIME=22:00

# ---- Business ----
# Used in text messages and as the account name in Google Authenticator
BUSINESS_NAME=Kisetsu Spa
# Quoted in text messages ("or call ..."); optional
SPA_PHONE=0917 123 4567

# ---- Authenticator codes (staff 2FA and the booking site) ----
# 32 random bytes, base64. Encrypts the authenticator secrets stored in MongoDB.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it safe and never change it: changing it breaks every set-up authenticator.
TOTP_ENCRYPTION_KEY=replace-with-32-random-bytes-base64

# ---- Public booking site ----
# Origins of the booking site (comma-separated), allowed on /booking/graphql only
BOOKING_CORS_ORIGINS=http://localhost:2500
# Link put in text messages ("please rebook at ...")
PUBLIC_BOOKING_URL=http://localhost:2500/book
# Requests per 15 minutes per IP on /booking/graphql
BOOKING_RATE_LIMIT_MAX=120
# Online bookings: up to this many days ahead, with at least this much notice
BOOKING_DAYS_AHEAD=7
BOOKING_MIN_LEAD_MINUTES=120

# ---- SMS ----
# console = print texts in the server log (development); semaphore = send through semaphore.co
SMS_PROVIDER=console
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=KISETSUSPA

# ---- Cloudflare Turnstile (bot check before texting a setup code) ----
# Secret key of your Turnstile widget. For local testing, Cloudflare's always-pass test secret:
# 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
