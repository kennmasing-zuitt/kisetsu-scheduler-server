# Copy to .env.test (ignored by git) before running tests:
#   cp .env.test.example .env.test

NODE_ENV=test
PORT=4002
LOG_LEVEL=error

# Separate database: the test setup refuses to run unless the name contains "test"
MONGO_URI=mongodb://localhost:27017/app-test

JWT_SECRET=test-only-secret-0123456789abcdef0123456789
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=4

CORS_ORIGINS=http://localhost:5173

# High limits so normal tests never hit 429
API_RATE_LIMIT_MAX=10000
AUTH_RATE_LIMIT_MAX=10000
